      },
      "material_decay_floor": {
        "description": "保鲜衰减下限",
        "type": "float",
        "default": 0.25,
        "slider": {
          "min": 0.0,
          "max": 1.0,
          "step": 0.05
        }
      }
    }
  },
  "proactive": {
    "description": "主动开口",
    "type": "object",
    "hint": "她按自己的意愿在群里先说话，而不是等别人 @。默认关闭。",
    "items": {
      "enabled": {
        "description": "启用主动开口",
        "type": "bool",
        "default": false
      },
      "provider_id": {
        "description": "主动开口模型",
        "type": "string",
        "_special": "select_provider",
        "default": "",
        "hint": "主动开口时用哪个模型润色。留空则跟随活动决策模型 / 当前会话模型。"
      },
      "summary_turns": {
        "description": "先用小模型总结最近几轮",
        "type": "int",
        "default": 25,
        "hint": "一轮=一问一答。总结成 1~3 句「他们最近在聊什么」交给主模型，避免只看几条就断章取义。填 0 关闭总结。"
      },
      "summary_provider_id": {
        "description": "总结用的模型",
        "type": "string",
        "_special": "select_provider",
        "default": "",
