        "slider": {
          "min": 0.0,
          "max": 1.0,
          "step": 0.01
        }
      },
      "roomy_ratio": {
        "description": "「宽裕」余额比例",
        "type": "float",
        "default": 0.6,
        "slider": {
          "min": 0.0,
          "max": 1.0,
          "step": 0.01
        }
      },
      "tight_pacing": {
        "description": "「紧张」节奏比",
        "type": "float",
        "default": 1.2,
        "slider": {
          "min": 1.0,
          "max": 5.0,
          "step": 0.1
        },
        "hint": "花费进度 / 时间进度 超过它也算手头紧。"
      },
      "pacing_from_spend_ratio": {
        "description": "节奏比生效的最低花费进度",
        "type": "float",
        "default": 0.5,
        "slider": {
          "min": 0.0,
          "max": 1.0,
          "step": 0.05
        },
        "hint": "月初时间进度很小，节奏比容易误报；花掉一半以上才用它升级档位。"
      },
      "hint_in_prompt": {
        "description": "把经济约束写进提示词",
        "type": "bool",
