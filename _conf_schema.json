      },
      "score_threshold": {
        "description": "开口分数阈值",
        "type": "float",
        "default": 0.45,
        "slider": {
          "min": 0.0,
          "max": 1.0,
          "step": 0.05
        },
        "hint": "意愿分低于它就不开口。"
      },
      "min_interval_minutes": {
        "description": "最短间隔（分钟）",
        "type": "int",
