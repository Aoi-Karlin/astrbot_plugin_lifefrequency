      },
      "price_output_per_mtok": {
        "description": "输出 token 单价（元 / 百万）",
        "type": "float",
        "default": 8.0,
        "slider": {
          "min": 0.0,
          "max": 1000.0,
          "step": 0.1
        }
      },
      "include_plugin_calls": {
        "description": "计入插件自身的模型调用",
        "type": "bool",
        "default": true,
        "hint": "AstrBot 的 token 统计只记录主对话；打开后本插件的活动决策/主动开口用量也计入。"
      },
      "refresh_interval_minutes": {
        "description": "取数间隔（分钟）",
