  "memory": {
    "description": "长期记忆联动",
    "type": "object",
    "hint": "需要安装 astrbot_plugin_livingmemory。没装也没关系，这里留着默认关闭即可，不会报错。",
    "items": {
      "enabled": {
        "description": "启用联动",
        "type": "bool",
        "default": false,
        "hint": "开启后会把她的生活写进 LivingMemory 长期记忆。检测不到该插件时自动跳过，不影响其它功能。"
      },
      "record_activity": {
        "description": "记录她的活动",
        "type": "bool",
        "default": true,
        "hint": "她换了活动就写一条（如「下午在阳台看雨，心情平静，有点累」）。属于她自己，不分群。"
      },
      "record_group_events": {
        "description": "记录群内对话",
        "type": "bool",
        "default": false,
        "hint": "群里有谁找她说话、她怎么回，写进该群自己的记忆（与对话记忆一样按群隔离）。默认关闭：LivingMemory 自己会总结对话，重复记录会让记忆变啰嗦。"
      }
    }
  },
