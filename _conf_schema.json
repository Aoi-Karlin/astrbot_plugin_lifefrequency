        "slider": {
          "min": 0,
          "max": 720,
          "step": 5
        }
      },
      "daily_max": {
        "description": "每日上限",
        "type": "int",
        "default": 1,
        "slider": {
          "min": 0,
          "max": 20,
          "step": 1
        }
      },
      "minimum_energy": {
        "description": "最低体力",
        "type": "float",
        "default": 2.5,
        "slider": {
          "min": 0.0,
          "max": 10.0,
          "step": 0.5
        }
      },
      "quiet_hours": {
        "description": "安静时段",
        "type": "list",
        "items": {
          "type": "string"
        },
        "default": [
          "00:00-08:00"
        ],
        "hint": "格式 HH:MM-HH:MM。这些时段绝不主动开口。"
      },
      "unanswered_backoff_factor": {
        "description": "没人理时的退避倍数",
        "type": "float",
        "default": 2.0,
        "slider": {
          "min": 1.0,
          "max": 10.0,
          "step": 0.5
        },
        "hint": "上次主动开口没人接话，下次间隔乘这个倍数。"
      },
      "unanswered_backoff_max_streak": {
        "description": "退避最大连击",
        "type": "int",
        "default": 4,
        "slider": {
          "min": 0,
          "max": 20,
          "step": 1
        }
      },
      "filter_mode": {
        "description": "生效范围",
        "type": "string",
        "default": "all",
        "options": [
          "all",
          "whitelist",
          "blacklist"
        ],
        "labels": [
          "全部会话",
          "仅白名单",
          "排除黑名单"
        ]
      },
      "target_chats": {
        "description": "范围名单",
        "type": "list",
        "items": {
          "type": "string"
        },
        "default": [],
        "hint": "一行一个。支持完整 umo、group:123456、private:123456 或裸 ID。"
      }
    }
